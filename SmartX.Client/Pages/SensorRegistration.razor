@page "/sensors/register"
@using System.Net.Http.Json
@using SmartX.Shared
@inject HttpClient Http

<PageTitle>Register Sensor</PageTitle>

<h1>Register IoT Sensor</h1>

<p class="text-muted">
    Add a new sensor to the Smart-X data ingestion gateway.
</p>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <EditForm Model="sensor" OnValidSubmit="RegisterSensor">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Device Name</label>

                <InputText class="form-control"
                           @bind-Value="sensor.DeviceName" />

                <ValidationMessage For="@(() => sensor.DeviceName)" />
            </div>

            <div class="mb-3">
                <label class="form-label">MAC Address</label>

                <InputText class="form-control"
                           @bind-Value="sensor.MacAddress"
                           placeholder="A4:C1:38:22:0F:91" />

                <ValidationMessage For="@(() => sensor.MacAddress)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Deployment Location</label>

                <InputText class="form-control"
                           @bind-Value="sensor.DeploymentLocation"
                           placeholder="Facility A - Zone 1" />

                <ValidationMessage For="@(() => sensor.DeploymentLocation)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Sensor Category</label>

                <InputSelect class="form-select"
                             @bind-Value="sensor.Category">
                    <option value="@SensorCategory.Environmental">
                        Environmental
                    </option>

                    <option value="@SensorCategory.PowerConsumption">
                        Power Consumption
                    </option>

                    <option value="@SensorCategory.Actuator">
                        Actuator
                    </option>
                </InputSelect>
            </div>

            <button class="btn btn-primary"
                    type="submit"
                    disabled="@isSubmitting">
                @(isSubmitting ? "Registering..." : "Register Sensor")
            </button>

            <a class="btn btn-outline-secondary ms-2" href="">
                Back to Dashboard
            </a>
        </EditForm>
    </div>
</div>

@code {
    private Sensor sensor = new();
    private bool isSubmitting;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    private async Task RegisterSensor()
    {
        isSubmitting = true;
        successMessage = string.Empty;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/sensors", sensor);

            if (response.IsSuccessStatusCode)
            {
                successMessage = "Sensor registered successfully.";
                sensor = new Sensor();
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch
        {
            errorMessage = "The sensor could not be registered. Check that the API is running.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}