@page "/deployment"
@using System.Net.Http.Json
@using SmartX.Shared
@inject HttpClient Http

<PageTitle>Deployment Validation</PageTitle>

<h1>Deployment Validation</h1>

<p class="text-muted">
    Validate nested Smart-X deployment zones and device configuration.
</p>

<button class="btn btn-primary mb-4"
        @onclick="RunValidation"
        disabled="@isLoading">
    @(isLoading ? "Validating..." : "Validate Deployment")
</button>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (result != null)
{
    @if (result.IsValid)
    {
        <div class="alert alert-success">
            All deployment nodes are configured correctly.
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Deployment configuration needs attention.
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5>Validation Summary</h5>

            <p class="mb-1">
                Nodes checked: <strong>@result.NodesChecked</strong>
            </p>

            <p class="mb-0">
                Issues found: <strong>@result.Issues.Count</strong>
            </p>
        </div>
    </div>

    @if (result.Issues.Count > 0)
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Configuration Issues</h5>

                <ul class="mb-0">
                    @foreach (var issue in result.Issues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            </div>
        </div>
    }
}

@code {
    private DeploymentValidationResult? result;
    private bool isLoading;
    private string errorMessage = string.Empty;

    private async Task RunValidation()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            result =
                await Http.GetFromJsonAsync<DeploymentValidationResult>(
                    "api/deployment/validate");
        }
        catch
        {
            errorMessage =
                "Deployment validation could not be completed.";
        }
        finally
        {
            isLoading = false;
        }
    }
}