@page "/sensor-files"
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@using SmartX.Shared
@inject HttpClient Http

<PageTitle>Sensor Files</PageTitle>

<h1>Sensor Files</h1>

<p class="text-muted">
    Attach configuration files, deployment photos or hardware logs to a sensor.
</p>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">Sensor</label>

            <select class="form-select"
                    @onchange="SensorChanged">
                <option value="">Select a sensor</option>

                @foreach (var sensor in sensors)
                {
                    <option value="@sensor.Id">
                        @sensor.DeviceName
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">File</label>

            <InputFile class="form-control"
                       OnChange="FileSelected" />

            <div class="form-text">
                TXT, LOG, JSON, JPG, PNG or PDF. Maximum 5 MB.
            </div>
        </div>

        <button class="btn btn-primary"
                @onclick="UploadFile"
                disabled="@isUploading">
            @(isUploading ? "Uploading..." : "Upload File")
        </button>
    </div>
</div>

<h3>Attached Files</h3>

@if (selectedSensorId == 0)
{
    <div class="alert alert-info">
        Select a sensor to view its files.
    </div>
}
else if (attachments.Count == 0)
{
    <div class="alert alert-info">
        No files are attached to this sensor.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>File</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var file in attachments)
                {
                    <tr>
                        <td>@file.FileName</td>
                        <td>@FormatSize(file.FileSize)</td>
                        <td>
                            @file.UploadedAt.ToLocalTime()
                            .ToString("dd MMM yyyy HH:mm")
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               href="@GetDownloadUrl(file.Id)"
                               target="_blank">
                                Download
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Sensor> sensors = new();
    private List<AttachmentRecord> attachments = new();

    private IBrowserFile? selectedFile;
    private int selectedSensorId;

    private bool isUploading;

    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        sensors =
            await Http.GetFromJsonAsync<List<Sensor>>(
                "api/sensors")
            ?? new List<Sensor>();
    }

    private async Task SensorChanged(ChangeEventArgs e)
    {
        successMessage = string.Empty;
        errorMessage = string.Empty;

        if (int.TryParse(
            e.Value?.ToString(),
            out int sensorId))
        {
            selectedSensorId = sensorId;

            await LoadAttachments();
        }
        else
        {
            selectedSensorId = 0;
            attachments.Clear();
        }
    }

    private void FileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        successMessage = string.Empty;
        errorMessage = string.Empty;
    }

    private async Task UploadFile()
    {
        if (selectedSensorId == 0)
        {
            errorMessage = "Select a sensor first.";
            return;
        }

        if (selectedFile == null)
        {
            errorMessage = "Select a file first.";
            return;
        }

        isUploading = true;
        successMessage = string.Empty;
        errorMessage = string.Empty;

        try
        {
            using var form =
                new MultipartFormDataContent();

            form.Add(
                new StringContent(
                    selectedSensorId.ToString()),
                "sensorId");

            using var stream =
                selectedFile.OpenReadStream(
                    5 * 1024 * 1024);

            using var fileContent =
                new StreamContent(stream);

            if (!string.IsNullOrWhiteSpace(
                selectedFile.ContentType))
            {
                fileContent.Headers.ContentType =
                    new MediaTypeHeaderValue(
                        selectedFile.ContentType);
            }

            form.Add(
                fileContent,
                "file",
                selectedFile.Name);

            var response =
                await Http.PostAsync(
                    "api/attachments/upload",
                    form);

            if (response.IsSuccessStatusCode)
            {
                successMessage =
                    "File uploaded and encrypted successfully.";

                selectedFile = null;

                await LoadAttachments();
            }
            else
            {
                errorMessage =
                    await response.Content.ReadAsStringAsync();
            }
        }
        catch
        {
            errorMessage =
                "The file could not be uploaded.";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task LoadAttachments()
    {
        attachments =
            await Http.GetFromJsonAsync<List<AttachmentRecord>>(
                $"api/attachments/sensor/{selectedSensorId}")
            ?? new List<AttachmentRecord>();
    }

    private string GetDownloadUrl(Guid id)
    {
        return $"http://localhost:5023/api/attachments/{id}/download";
    }

    private string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        return $"{bytes / 1024.0:0.0} KB";
    }
}