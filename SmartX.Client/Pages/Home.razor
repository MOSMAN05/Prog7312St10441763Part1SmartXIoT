@page "/"
@using System.Net.Http.Json
@using SmartX.Shared
@inject HttpClient Http

<PageTitle>Smart-X Dashboard</PageTitle>

<h1>Smart-X IoT Gateway</h1>

<p class="text-muted">
    Monitor sensor registrations, telemetry ingestion and gateway activity.
</p>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">
        @errorMessage
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Registered Sensors</h5>
                <h2>@sensors.Count</h2>
                <p class="card-text text-muted">
                    Devices currently registered with the gateway.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Online Sensors</h5>
                <h2>@OnlineSensorCount</h2>
                <p class="card-text text-muted">
                    Sensors currently reporting as online.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Disconnected Sensors</h5>
                <h2>@DisconnectedSensorCount</h2>
                <p class="card-text text-muted">
                    Sensors that are currently offline.
                </p>
            </div>
        </div>
    </div>
</div>

<h3 class="mb-3">Gateway Modules</h3>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h5 class="card-title">Sensor Data Ingestion and Telemetry</h5>

                <p class="card-text">
                    Register IoT devices and manage incoming sensor data.
                </p>

                <a class="btn btn-primary" href="sensors/register">
                    Open Module
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Real-Time Command Stream and History</h5>

                <p class="card-text">
                    Device command processing and command history.
                </p>

                <button class="btn btn-secondary" disabled>
                    Part 2
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Network Topology and Mesh Routing</h5>

                <p class="card-text">
                    Visualise gateway nodes, deployment zones and mesh routes.
                </p>

                <button class="btn btn-secondary" disabled>
                    Final PoE
                </button>
            </div>
        </div>
    </div>
</div>

<h3 class="mb-3">Current Sensors</h3>

@if (isLoading)
{
    <p>Loading sensors...</p>
}
else if (sensors.Count == 0)
{
    <div class="alert alert-info">
        No sensors are currently registered.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>MAC Address</th>
                    <th>Location</th>
                    <th>Category</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var sensor in sensors)
                {
                    <tr>
                        <td>@sensor.DeviceName</td>
                        <td>@sensor.MacAddress</td>
                        <td>@sensor.DeploymentLocation</td>
                        <td>@FormatCategory(sensor.Category)</td>
                        <td>
                            @if (sensor.IsOnline)
                            {
                                <span class="badge bg-success">Online</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Disconnected</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Sensor> sensors = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    private int OnlineSensorCount =>
        sensors.Count(sensor => sensor.IsOnline);

    private int DisconnectedSensorCount =>
        sensors.Count(sensor => !sensor.IsOnline);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sensors = await Http.GetFromJsonAsync<List<Sensor>>("api/sensors")
                      ?? new List<Sensor>();
        }
        catch
        {
            errorMessage = "The dashboard could not connect to the Smart-X API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatCategory(SensorCategory category)
    {
        return category switch
        {
            SensorCategory.PowerConsumption => "Power Consumption",
            _ => category.ToString()
        };
    }
}