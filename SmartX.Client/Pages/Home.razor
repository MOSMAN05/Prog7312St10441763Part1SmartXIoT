@page "/"
@using System.Net.Http.Json
@using SmartX.Shared
@implements IAsyncDisposable
@inject HttpClient Http

<PageTitle>Smart-X Dashboard</PageTitle>

<div class="dashboard-header">
    <div>
        <h1>Smart-X IoT Gateway</h1>
        <p class="text-muted mb-0">
            Monitor connected devices, telemetry and gateway activity.
        </p>
    </div>

    <button class="btn btn-outline-primary"
            disabled="@isLoading"
            @onclick="() => LoadDashboard()">
        Refresh Dashboard
    </button>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning">
        @errorMessage
    </div>
}

@if (DisconnectedSensorCount > 0 || summary.AnomalyCount > 0)
{
    <div class="alert alert-danger">
        <h5>System Attention Required</h5>

        @if (DisconnectedSensorCount > 0)
        {
            <div>
                @DisconnectedSensorCount disconnected device(s) detected.
            </div>
        }

        @if (summary.AnomalyCount > 0)
        {
            <div>
                @summary.AnomalyCount abnormal telemetry reading(s) recorded.
            </div>
        }

        <a href="alerts" class="btn btn-sm btn-outline-danger mt-2">
            Review Alerts
        </a>
    </div>
}
else
{
    <div class="alert alert-success">
        All monitored devices are reporting normally.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <h6 class="text-muted">Registered Sensors</h6>
                <h2>@sensors.Count</h2>
                <p class="mb-0">Devices registered with Smart-X.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <h6 class="text-muted">Online Sensors</h6>
                <h2 class="text-success">@OnlineSensorCount</h2>
                <p class="mb-0">Devices currently connected.</p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <h6 class="text-muted">Disconnected Sensors</h6>
                <h2 class="text-danger">@DisconnectedSensorCount</h2>
                <p class="mb-0">Devices requiring attention.</p>
            </div>
        </div>
    </div>
</div>

<h3 class="section-title">Gateway Modules</h3>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card module-card active-module h-100">
            <div class="card-body d-flex flex-column">
                <h5>Sensor Data Ingestion and Telemetry</h5>
                <p>
                    View incoming telemetry, processing queues
                    and historical sensor readings.
                </p>

                <a class="btn btn-primary mt-auto"
                   href="telemetry-history">
                    Open Module
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card module-card active-module h-100">
            <div class="card-body d-flex flex-column">
                <h5>Real-Time Command Stream and History</h5>
                <p>
                    Monitor device states, issue commands
                    and review command history.
                </p>

                <a class="btn btn-primary mt-auto"
                   href="command-stream">
                    Open Module
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card module-card active-module h-100">
            <div class="card-body d-flex flex-column">
                <h5>Network Topology and Mesh Routing</h5>
                <p>
                    View the network structure and calculate
                    the shortest route for device alerts.
                </p>

                <a class="btn btn-primary mt-auto"
                   href="network-topology">
                    Open Module
                </a>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-outline-primary" href="sensors/register">
        Register Sensor
    </a>

    <a class="btn btn-outline-primary" href="recommendations">
        Predictive Insights
    </a>

    <a class="btn btn-outline-primary" href="deployment">
        Validate Deployment
    </a>

    <a class="btn btn-outline-primary" href="sensor-files">
        Sensor Files
    </a>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-0">Live Telemetry</h3>

        @if (summary.LastUpdated != default)
        {
            <small class="text-muted">
                Last updated:
                @summary.LastUpdated.ToLocalTime().ToString("HH:mm:ss")
            </small>
        }
    </div>

    <button class="btn btn-success"
            disabled="@isSimulating"
            @onclick="SimulateTelemetry">
        @(isSimulating ? "Processing..." : "Simulate Telemetry")
    </button>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Latest Temperature</h6>
                <h3>@summary.LatestTemperatureC.ToString("0.0") °C</h3>

                @if (summary.LatestTemperatureC > 35)
                {
                    <span class="badge bg-danger">
                        Temperature Spike
                    </span>
                }
                else
                {
                    <span class="badge bg-success">Normal</span>
                }
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Power Load</h6>
                <h3>@summary.AggregatePowerKw.ToString("0.00") kW</h3>

                <small class="text-muted">
                    Highest source: @summary.HigherPowerSource
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Total Packets</h6>
                <h3>@summary.TotalPackets</h3>

                <small class="text-muted">
                    Processed by the gateway
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Detected Anomalies</h6>
                <h3>@summary.AnomalyCount</h3>

                <small class="text-muted">
                    Total abnormal readings
                </small>
            </div>
        </div>
    </div>
</div>

@if (DisconnectedSensorCount > 0 || summary.AnomalyCount > 0)
{
    <div class="card troubleshooting-card mb-4">
        <div class="card-body">
            <h5>Troubleshooting Guidance</h5>

            @if (DisconnectedSensorCount > 0)
            {
                <p>
                    Check the disconnected device's power supply,
                    network connection and deployment location.
                </p>
            }

            @if (summary.AnomalyCount > 0)
            {
                <p class="mb-0">
                    Compare abnormal readings with historical telemetry
                    before checking the affected sensor.
                </p>
            }
        </div>
    </div>
}

<h3 class="section-title">Recent Telemetry</h3>

@if (records.Count == 0)
{
    <p class="text-muted">No telemetry readings available.</p>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-striped table-hover align-middle smart-table">
            <thead>
                <tr>
                    <th>Sensor</th>
                    <th>Metric</th>
                    <th>Reading</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var record in records)
                {
                    <tr class="@(record.IsAnomaly ? "table-danger" : "")">
                        <td>@record.DeviceName</td>
                        <td>@record.Metric</td>
                        <td>@record.Value @record.Unit</td>
                        <td>
                            @record.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </td>
                        <td>
                            <span class="badge @(record.IsAnomaly ? "bg-danger" : "bg-success")">
                                @(record.IsAnomaly ? "Anomaly" : "Normal")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h3 class="section-title">Current Sensors</h3>

@if (sensors.Count == 0)
{
    <p class="text-muted">No registered sensors available.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle smart-table">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>MAC Address</th>
                    <th>Location</th>
                    <th>Category</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var sensor in sensors)
                {
                    <tr>
                        <td><strong>@sensor.DeviceName</strong></td>
                        <td>@sensor.MacAddress</td>
                        <td>@sensor.DeploymentLocation</td>
                        <td>@FormatCategory(sensor.Category)</td>
                        <td>
                            <span class="badge @(sensor.IsOnline ? "bg-success" : "bg-danger")">
                                @(sensor.IsOnline ? "Online" : "Disconnected")
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Sensor> sensors = new();
    private List<TelemetryRecord> records = new();
    private TelemetrySummary summary = new();

    private string errorMessage = string.Empty;
    private bool isLoading;
    private bool isSimulating;

    private CancellationTokenSource? refreshCancellation;
    private Task? refreshTask;

    private int OnlineSensorCount =>
        sensors.Count(sensor => sensor.IsOnline);

    private int DisconnectedSensorCount =>
        sensors.Count(sensor => !sensor.IsOnline);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();

        refreshCancellation = new CancellationTokenSource();
        refreshTask = RefreshLoop(refreshCancellation.Token);
    }

    private async Task LoadDashboard(
        CancellationToken cancellationToken = default)
    {
        if (isLoading)
        {
            return;
        }

        isLoading = true;

        try
        {
            var sensorTask = Http.GetFromJsonAsync<List<Sensor>>(
                "api/sensors", cancellationToken);

            var summaryTask = Http.GetFromJsonAsync<TelemetrySummary>(
                "api/telemetry/summary", cancellationToken);

            var recordTask = Http.GetFromJsonAsync<List<TelemetryRecord>>(
                "api/telemetry/recent", cancellationToken);

            await Task.WhenAll(sensorTask, summaryTask, recordTask);

            sensors = await sensorTask ?? new();
            summary = await summaryTask ?? new();
            records = await recordTask ?? new();

            errorMessage = string.Empty;
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
        }
        catch
        {
            errorMessage = "Could not connect to the Smart-X API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RefreshLoop(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    if (!isLoading && !isSimulating)
                    {
                        await LoadDashboard(token);
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task SimulateTelemetry()
    {
        isSimulating = true;
        errorMessage = string.Empty;

        try
        {
            var response = await Http.PostAsync(
                "api/telemetry/simulate", null);

            if (response.IsSuccessStatusCode)
            {
                await LoadDashboard();
            }
            else
            {
                errorMessage = "Could not process the telemetry batch.";
            }
        }
        catch
        {
            errorMessage = "Telemetry simulation failed.";
        }
        finally
        {
            isSimulating = false;
        }
    }

    private static string FormatCategory(SensorCategory category)
    {
        return category == SensorCategory.PowerConsumption
            ? "Power Consumption"
            : category.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        if (refreshCancellation == null)
        {
            return;
        }

        refreshCancellation.Cancel();

        if (refreshTask != null)
        {
            try
            {
                await refreshTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        refreshCancellation.Dispose();
    }
}
