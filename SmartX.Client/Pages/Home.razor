@page "/"
@using System.Net.Http.Json
@using SmartX.Shared
@inject HttpClient Http

<PageTitle>Smart-X Dashboard</PageTitle>

<div class="dashboard-header">
    <div>
        <h1>Smart-X IoT Gateway</h1>
        <p class="text-muted mb-0">
            Monitor sensor registrations, telemetry ingestion and gateway activity.
        </p>
    </div>

    <button class="btn btn-outline-primary"
            @onclick="LoadDashboard"
            disabled="@isLoading">
        @(isLoading ? "Refreshing..." : "Refresh Dashboard")
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-warning">
        @errorMessage
    </div>
}

@if (DisconnectedSensorCount > 0 || telemetrySummary.AnomalyCount > 0)
{
    <div class="alert alert-danger system-alert">
        <h5>System Attention Required</h5>

        @if (DisconnectedSensorCount > 0)
        {
            <div>
                @DisconnectedSensorCount sensor(s) are currently disconnected.
            </div>
        }

        @if (telemetrySummary.AnomalyCount > 0)
        {
            <div>
                @telemetrySummary.AnomalyCount anomalous telemetry reading(s)
                have been detected.
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-success">
        All monitored sensor activity is currently normal.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <h6 class="text-muted">Registered Sensors</h6>
                <h2>@sensors.Count</h2>
                <p class="mb-0">
                    Devices registered with the gateway.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <h6 class="text-muted">Online Sensors</h6>
                <h2 class="text-success">@OnlineSensorCount</h2>
                <p class="mb-0">
                    Sensors currently reporting as online.
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card dashboard-card h-100">
            <div class="card-body">
                <h6 class="text-muted">Disconnected Sensors</h6>
                <h2 class="text-danger">@DisconnectedSensorCount</h2>
                <p class="mb-0">
                    Sensors requiring connection checks.
                </p>
            </div>
        </div>
    </div>
</div>

<h3 class="section-title">Gateway Modules</h3>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="card module-card active-module h-100">
            <div class="card-body">
                <h5>Sensor Data Ingestion and Telemetry</h5>

                <p>
                    Register devices and monitor incoming IoT sensor data.
                </p>

                <a class="btn btn-primary"
                   href="sensors/register">
                    Open Module
                </a>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card module-card h-100">
            <div class="card-body">
                <h5>Real-Time Command Stream and History</h5>

                <p>
                    Device command processing and command history.
                </p>

                <button class="btn btn-secondary"
                        disabled>
                    Part 2
                </button>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card module-card h-100">
            <div class="card-body">
                <h5>Network Topology and Mesh Routing</h5>

                <p>
                    Visualise deployment zones and future mesh routes.
                </p>

                <button class="btn btn-secondary"
                        disabled>
                    Final PoE
                </button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a class="btn btn-outline-primary"
       href="deployment">
        Validate Deployment
    </a>

    <a class="btn btn-outline-primary"
       href="sensor-files">
        Manage Sensor Files
    </a>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h3 class="mb-0">Live Telemetry</h3>

        @if (telemetrySummary.LastUpdated != default)
        {
            <small class="text-muted">
                Last updated:
                @telemetrySummary.LastUpdated.ToLocalTime().ToString("HH:mm:ss")
            </small>
        }
    </div>

    <button class="btn btn-success"
            @onclick="SimulateTelemetry"
            disabled="@isSimulating">
        @(isSimulating ? "Processing..." : "Simulate Telemetry")
    </button>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Latest Temperature</h6>

                <h3>
                    @telemetrySummary.LatestTemperatureC.ToString("0.0") °C
                </h3>

                @if (telemetrySummary.LatestTemperatureC > 35)
                {
                    <span class="badge bg-danger">
                        Temperature Spike
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        Normal
                    </span>
                }
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Power Load</h6>

                <h3>
                    @telemetrySummary.AggregatePowerKw.ToString("0.00") kW
                </h3>

                <small class="text-muted">
                    Highest source: @telemetrySummary.HigherPowerSource
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Total Packets</h6>
                <h3>@telemetrySummary.TotalPackets</h3>

                <small class="text-muted">
                    Processed by the gateway
                </small>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-lg-3">
        <div class="card telemetry-card h-100">
            <div class="card-body">
                <h6>Detected Anomalies</h6>
                <h3>@telemetrySummary.AnomalyCount</h3>

                @if (telemetrySummary.AnomalyCount > 0)
                {
                    <span class="badge bg-danger">
                        Review Required
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        Clear
                    </span>
                }
            </div>
        </div>
    </div>
</div>

@if (DisconnectedSensorCount > 0 || telemetrySummary.AnomalyCount > 0)
{
    <div class="card troubleshooting-card mb-4">
        <div class="card-body">
            <h5>Troubleshooting Guidance</h5>

            @if (DisconnectedSensorCount > 0)
            {
                <p class="mb-2">
                    Check the disconnected sensor's power, network connection
                    and last known deployment location.
                </p>
            }

            @if (telemetrySummary.AnomalyCount > 0)
            {
                <p class="mb-0">
                    Compare the abnormal reading with recent telemetry before
                    inspecting the affected sensor.
                </p>
            }
        </div>
    </div>
}

@if (telemetryRecords.Count > 0)
{
    <h3 class="section-title">Recent Telemetry</h3>

    <div class="table-responsive mb-4">
        <table class="table table-striped table-hover align-middle smart-table">
            <thead>
                <tr>
                    <th>Sensor</th>
                    <th>Metric</th>
                    <th>Value</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var record in telemetryRecords)
                {
                    <tr class="@(record.IsAnomaly ? "table-danger" : "")">
                        <td>@record.DeviceName</td>
                        <td>@record.Metric</td>
                        <td>@record.Value @record.Unit</td>
                        <td>
                            @record.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </td>
                        <td>
                            @if (record.IsAnomaly)
                            {
                                <span class="badge bg-danger">
                                    Anomaly
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Normal
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h3 class="section-title">Current Sensors</h3>

@if (isLoading)
{
    <p>Loading sensors...</p>
}
else if (sensors.Count == 0)
{
    <div class="alert alert-info">
        No sensors are currently registered.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle smart-table">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>MAC Address</th>
                    <th>Location</th>
                    <th>Category</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var sensor in sensors)
                {
                    <tr>
                        <td>
                            <strong>@sensor.DeviceName</strong>
                        </td>

                        <td>@sensor.MacAddress</td>
                        <td>@sensor.DeploymentLocation</td>
                        <td>@FormatCategory(sensor.Category)</td>

                        <td>
                            @if (sensor.IsOnline)
                            {
                                <span class="badge bg-success">
                                    Online
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Disconnected
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Sensor> sensors = new();
    private List<TelemetryRecord> telemetryRecords = new();

    private TelemetrySummary telemetrySummary = new();

    private bool isLoading = true;
    private bool isSimulating;

    private string errorMessage = string.Empty;

    private int OnlineSensorCount =>
        sensors.Count(sensor => sensor.IsOnline);

    private int DisconnectedSensorCount =>
        sensors.Count(sensor => !sensor.IsOnline);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var sensorTask =
                Http.GetFromJsonAsync<List<Sensor>>(
                    "api/sensors");

            var summaryTask =
                Http.GetFromJsonAsync<TelemetrySummary>(
                    "api/telemetry/summary");

            var telemetryTask =
                Http.GetFromJsonAsync<List<TelemetryRecord>>(
                    "api/telemetry/recent");

            await Task.WhenAll(
                sensorTask,
                summaryTask,
                telemetryTask);

            sensors =
                await sensorTask ?? new List<Sensor>();

            telemetrySummary =
                await summaryTask ?? new TelemetrySummary();

            telemetryRecords =
                await telemetryTask ?? new List<TelemetryRecord>();
        }
        catch
        {
            errorMessage =
                "The dashboard could not connect to the Smart-X API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SimulateTelemetry()
    {
        isSimulating = true;
        errorMessage = string.Empty;

        try
        {
            var response =
                await Http.PostAsync(
                    "api/telemetry/simulate",
                    null);

            if (response.IsSuccessStatusCode)
            {
                await LoadDashboard();
            }
            else
            {
                errorMessage =
                    "The API could not process the telemetry batch.";
            }
        }
        catch
        {
            errorMessage =
                "Telemetry simulation could not be completed.";
        }
        finally
        {
            isSimulating = false;
        }
    }

    private string FormatCategory(SensorCategory category)
    {
        return category switch
        {
            SensorCategory.PowerConsumption =>
                "Power Consumption",

            _ => category.ToString()
        };
    }
}